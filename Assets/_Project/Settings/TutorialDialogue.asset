  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6d7b95f9f2644d4ea2d0d62f4c2b77b0, type: 3}
  m_Name: TutorialDialogue
  m_EditorClassIdentifier: 
  _lines:
  - text: "\u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u0441 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430\u043C\u0438 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0430\u0436\u0430\u0442\u0438\u0435 \u043D\u0430
      \u043F\u0440\u0430\u0432\u044B\u0439 \u043A\u0443\u0440\u043E\u043A (\u0441\u0440\u0435\u0434\u043D\u0438\u0439
      \u043F\u0430\u043B\u0435\u0446)."
    audioClip: {fileID: 8300000, guid: 1e9a52c8b6e11f849ac61b5eca84592b, type: 3}
  - text: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0438\u043B\u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044C
      \u043F\u0440\u043E\u0444\u0438\u043B\u044C, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043D\u0430\u0436\u0430\u0442\u044C \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443
      X \u043D\u0430 \u043B\u0435\u0432\u043E\u043C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0435
      (\u0444\u0443\u043D\u043A\u0446\u0438\u044F \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F
      \u043F\u043E\u0441\u043B\u0435 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F)."
    audioClip: {fileID: 8300000, guid: f9b572be1bd6c46429f299b6cc738de8, type: 3}
  - text: "\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0447\u0435\u0440\u0435\u0437
      \u043D\u0430\u0436\u0430\u0442\u0438\u0435 \u043A\u043D\u043E\u043F\u043A\u0438
      A \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u043C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0435
      (\u043A\u043E\u0433\u0434\u0430 \u0441\u043A\u0430\u043D\u0435\u0440 \u0432
      \u0440\u0443\u043A\u0435)."
    audioClip: {fileID: 8300000, guid: 6860a62aebe91ae48adf4bde6b7a8da7, type: 3}
