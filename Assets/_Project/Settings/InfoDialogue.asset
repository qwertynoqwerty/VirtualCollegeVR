%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aa33d0317643474ea3ce4fd598324cde, type: 3}
  m_Name: InfoDialogue
  m_EditorClassIdentifier: 
  _entries:
  - infoId: 1
    npcName: "\u041A\u0443\u0440\u0430\u0442\u043E\u0440"
    lines:
    - text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439! \u042F
        \u0442\u0432\u043E\u0439 \u043A\u0443\u0440\u0430\u0442\u043E\u0440, \u0431\u0443\u0434\u0443
        \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u0442\u0435\u0431\u0435
        \u0441 \u043E\u0441\u0432\u043E\u0435\u043D\u0438\u0435\u043C \u0432 \u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435."
      audioClip: {fileID: 8300000, guid: b3ad2303805dbbc43a37ca348306ce2a, type: 3}
    - text: "\u0412 \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
        \u0442\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0448\u044C\u0441\u044F
        \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u043C
        \u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435. \u0414\u043B\u044F \u0442\u043E\u0433\u043E
        \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C
        \u0444\u0443\u043D\u043A\u0446\u0438\u044E \u043F\u0440\u043E\u0444\u0438\u043B\u044F,
        \u0442\u0435\u0431\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
        \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E
        \u0441 \u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435\u043C!"
      audioClip: {fileID: 8300000, guid: 1c50b817a5f62b94ab0726d813f08895, type: 3}
    - text: "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0443\u0436\u043D\u043E
        \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F
        \u0441 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044F\u043C\u0438,
        \u043F\u0435\u0440\u0432\u044B\u0439 \u0438\u0437 \u043D\u0438\u0445 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
        \u0432 \u0441\u043F\u043E\u0440\u0442\u0437\u0430\u043B\u0435, \u043F\u043E\u0437\u0430\u0434\u0438
        \u043C\u0435\u043D\u044F, \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0441\u044F
        \u043A \u043D\u0435\u043C\u0443."
      audioClip: {fileID: 8300000, guid: c4386c4806af1b44d83e0e48d7e3195b, type: 3}
  - infoId: 2
    npcName: "\u041A\u0443\u0440\u0430\u0442\u043E\u0440"
    lines:
    - text: "\u041C\u043E\u043B\u043E\u0434\u0435\u0446! \u0422\u0435\u043F\u0435\u0440\u044C
        \u0442\u0435\u0431\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D
        \u043F\u0440\u043E\u0444\u0438\u043B\u044C, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
        \u0442\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
        \u0441\u0432\u043E\u0439 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441. "
      audioClip: {fileID: 8300000, guid: ecfb406f6ce135d49b182d74e142a166, type: 3}
    - text: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u0442\u0443\u043F\u0430\u0439,
        \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E \u0441 \u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435\u043C
        \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E!"
      audioClip: {fileID: 8300000, guid: 53530632f16b5464aab10447d9822473, type: 3}
  - infoId: 3
    npcName: "\u0422\u0440\u0435\u043D\u0435\u0440"
    lines:
    - text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439. \u042F
        \u044F\u0432\u043B\u044F\u044E\u0441\u044C \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u0435\u043C
        \u0444\u0438\u0437\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B \u0432
        \u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435."
      audioClip: {fileID: 8300000, guid: c0fa96925718b654696a04d6c8eb9969, type: 3}
    - text: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0442\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0448\u044C\u0441\u044F
        \u0432 \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u043C \u0437\u0430\u043B\u0435.
        \u0417\u0434\u0435\u0441\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442\u0441\u044F
        \u0437\u0430\u043D\u044F\u0442\u0438\u044F \u043F\u043E \u0444\u0438\u0437\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0435."
      audioClip: {fileID: 8300000, guid: a3a2c100f27ecb84c94f9c0e41b7e433, type: 3}
    - text: "\u041E\u0431\u0440\u0430\u0442\u0438 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435:
        \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0435 \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u0438\u0435
        \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u044B\u0445 \u0437\u0430\u043D\u044F\u0442\u0438\u0439
        \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u0435\u0442
        \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0439
        \u0444\u043E\u0440\u043C\u044B."
      audioClip: {fileID: 8300000, guid: 1b17bf1a849289c4fb7983d163ac33cc, type: 3}
    - text: "\u0421\u043E\u0432\u0435\u0442\u0443\u044E \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C,
        \u0431\u0435\u0437 \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u0439
        \u0444\u043E\u0440\u043C\u044B, \u043D\u0430 \u0437\u0430\u043D\u044F\u0442\u0438\u044F
        \u044F \u043D\u0435 \u043F\u0443\u0441\u043A\u0430\u044E."
      audioClip: {fileID: 8300000, guid: 6341dd2dd2e6ae84dae13698828a308d, type: 3}
    - text: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u0442\u0443\u043F\u0430\u0439
        \u0432 \u0443\u0447\u0435\u0431\u043D\u0443\u044E \u0447\u0430\u0441\u0442\u044C,
        \u043E\u043D\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
        \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C \u044D\u0442\u0430\u0436\u0435,
        \u0442\u0435\u0431\u044F \u0443\u0436\u0435 \u0436\u0434\u0443\u0442."
      audioClip: {fileID: 8300000, guid: fee604c3fdb4a2a49bc3f146bd903353, type: 3}
  - infoId: 4
    npcName: "\u0417\u0430\u0432\u0435\u0434\u0443\u044E\u0449\u0430\u044F"
    lines:
    - text: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C. \u042F
        \u0437\u0430\u0432\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0443\u0447\u0435\u0431\u043D\u043E\u0439
        \u0447\u0430\u0441\u0442\u0438."
      audioClip: {fileID: 8300000, guid: 76eea7902ee39fa4dbe690943f67a753, type: 3}
    - text: "\u0423\u0447\u0435\u0431\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u044C
        \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0437\u0430 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044E
        \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
        \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430."
      audioClip: {fileID: 8300000, guid: 5f99251fe7ca8f24c916f48005fa75d5, type: 3}
    - text: "\u0410 \u0438\u043C\u0435\u043D\u043D\u043E: \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435
        \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044F, \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
        \u0433\u0440\u0443\u043F\u043F \u0438 \u0443\u0447\u0451\u0442 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u043C\u043E\u0441\u0442\u0438
        \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432."
      audioClip: {fileID: 8300000, guid: 556289641bd84e34d97da206776595fb, type: 3}
    - text: "\u041F\u0440\u0438 \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438
        \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432 \u043F\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044E
        \u0437\u0430\u0434\u0430\u043D\u0438\u0439, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
        \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u043A \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u043C\u0443
        \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044E."
      audioClip: {fileID: 8300000, guid: d6ac3e37151961946905176add829ebb, type: 3}
    - text: "\u0415\u0441\u043B\u0438 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432
        \u043D\u0435\u0442, \u0442\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F
        \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043A \u043A\u0443\u0440\u0430\u0442\u043E\u0440\u0443."
      audioClip: {fileID: 8300000, guid: 08fd20d65833c3f4baae995ca551f8f0, type: 3}
  - infoId: 5
    npcName: "\u0421\u0442\u0443\u0434\u0435\u043D\u0442"
    lines:
    - text: "\u041F\u0435\u0440\u0432\u044B\u0439 \u043A\u0443\u0440\u0441? \u0414\u0430\u0432\u0430\u0439-\u043A\u0430
        \u044F \u0434\u0430\u043C \u0442\u0435\u0431\u0435 \u043F\u0430\u0440\u0443
        \u0441\u043E\u0432\u0435\u0442\u043E\u0432."
      audioClip: {fileID: 8300000, guid: 99c42eb2cf361d849a4154bac74af797, type: 3}
    - text: "\u041D\u0435 \u0441\u043F\u0435\u0448\u0438 \u0441\u0434\u0430\u0432\u0430\u0442\u044C
        \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0441\u0440\u0430\u0437\u0443.
        \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u043E\u0431\u0449\u0430\u0439\u0441\u044F,
        \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043A\u0432\u0435\u0441\u0442\u044B
        \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435
        \u0434\u0438\u0430\u043B\u043E\u0433\u043E\u0432."
      audioClip: {fileID: 8300000, guid: de23c98d7b2041a45a976a1a887697ad, type: 3}
    - text: "\u0415\u0441\u043B\u0438 \u043A\u0432\u0435\u0441\u0442 \u043D\u0435
        \u0437\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
        \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u0442\u044B
        \u0437\u0430\u0431\u044B\u043B \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
        \u043A \u0442\u043E\u043C\u0443, \u043A\u0442\u043E \u0435\u0433\u043E \u0434\u0430\u043B."
      audioClip: {fileID: 8300000, guid: f4f516f02acca6d4e9a775e1bb31dbdf, type: 3}
    - text: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043D\u0435 \u043D\u0430\u0436\u0438\u043C\u0430\u0442\u044C
        \u0432\u0441\u0451 \u043F\u043E\u0434\u0440\u044F\u0434, \u0430 \u0447\u0438\u0442\u0430\u0442\u044C.
        \u041D\u043E \u0442\u044B \u043D\u0435 \u0438\u0437 \u0442\u0430\u043A\u0438\u0445,
        \u044F \u043D\u0430\u0434\u0435\u044E\u0441\u044C."
      audioClip: {fileID: 8300000, guid: 651e3b14b228bd748b4b920ffca7d60e, type: 3}
  - infoId: 6
    npcName: "\u041F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044C"
    lines:
    - text: "\u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
        \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0430
        \u043D\u0430 \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
        \u043D\u0430\u0432\u044B\u043A\u043E\u0432 \u0447\u0435\u0440\u0435\u0437
        \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0439
        \u0441\u0440\u0435\u0434\u0435."
      audioClip: {fileID: 8300000, guid: 93f793c3242bdfe40b6a5e7cfe3f90e2, type: 3}
    - text: "\u041C\u043D\u043E\u0433\u0438\u0435 \u043A\u0432\u0435\u0441\u0442\u044B
        \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
        \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0447\u0435\u0439
        \u0437\u0430\u0434\u0430\u0447\u0435. \u041E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u0441\u044C
        \u043A \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044E \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E."
      audioClip: {fileID: 8300000, guid: 8c672452b9635c44cba90dcbeb76d9b9, type: 3}
    - text: "\u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F
        \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043A\u0432\u0435\u0441\u0442\u043E\u0432
        \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E \u043F\u0440\u043E\u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
        \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u0441\u0432\u043E\u0438\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
        \u0434\u043B\u044F \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F
        \u043D\u0430\u0432\u044B\u043A\u0430."
      audioClip: {fileID: 8300000, guid: 4348f903699a2294c8f72a45a35123ad, type: 3}
  - infoId: 7
    npcName: "\u0421\u0442\u0443\u0434\u0435\u043D\u0442"
    lines:
    - text: "\u0412\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u044B
        \u0438\u043C\u0435\u044E\u0442 \u0434\u0432\u0430 \u0432\u0438\u0434\u0430
        \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u044D\u0442\u043E
        \u043F\u043B\u0430\u0432\u043D\u043E\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
        \u0438 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430\u0446\u0438\u044F."
      audioClip: {fileID: 8300000, guid: 505d06860334624408427188e65d601f, type: 3}
    - text: "\u0412 \u0434\u0430\u043D\u043D\u043E\u043C \u0441\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0435
        \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u0432\u0441\u0435\u0433\u043E
        \u043E\u0434\u0438\u043D \u0440\u0435\u0436\u0438\u043C \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F,
        \u044D\u0442\u043E \u043F\u043B\u0430\u0432\u043D\u043E\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435."
      audioClip: {fileID: 8300000, guid: 7768f5e40fb78ef4d959c17b0af735e9, type: 3}
    - text: "\u0417\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439 \u043E\u0442\u043A\u0443\u0434\u0430
        \u0438 \u043A\u0443\u0434\u0430 \u0442\u044B \u0438\u0434\u0451\u0448\u044C,
        \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u0442\u044C\u0441\u044F."
      audioClip: {fileID: 8300000, guid: 5702119985b7a714386b76eac1fbd88b, type: 3}
    - text: "\u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u0437\u043E\u043D\u044B
        \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u044B \u044F\u0440\u043A\u043E\u0439
        \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u043E\u0439. \u0421 \u043D\u0438\u043C\u0438
        \u043C\u043E\u0436\u043D\u043E \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C."
      audioClip: {fileID: 8300000, guid: c5d69d2c6a39f0d4293c649d6aa2fb69, type: 3}
