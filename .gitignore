# =========================================================
# UNITY + RIDER + WINDOWS .gitignore
# =========================================================

# ========== Unity generated ==========
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
sysinfo.txt

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# ========== Visual Studio / VSCode ==========
.vs/
.vscode/
*.suo
*.user
*.userprefs
*.csproj
*.pidb
*.unityproj
*.sln
*.svd


# ========== OS generated ==========
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ========== Crash Reports / Logs ==========
sysinfo.txt

# ========== Unity Cache / Artifacts ==========
[Aa]ssets/AssetStoreTools*
[Bb]uild/
[Bb]uilds/
[Pp]rojectSettings/EditorBuildSettings.asset.bak

# ========== Ignore old build data / backups ==========
[Tt]emp/
[Bb]uild/
[Bb]uilds/
[Oo]bj/
*.bak
*.tmp
*.old
*.swp

# ========== Rider / JetBrains project settings ==========
.idea/
*.iml
out/

# =========================================================
# End of file
# =========================================================
